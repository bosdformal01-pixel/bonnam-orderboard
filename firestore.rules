rules_version = '2';
// 주문판 저장 공간 규칙: 아래 목록에 있는 구글 계정만 주문을 읽고 쓸 수 있어요.
// 계정을 추가하려면 따옴표 안에 메일 주소를 쉼표로 이어서 넣어요.
service cloud.firestore {
  match /databases/{database}/documents {
    function shop() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ["bosdformal01@gmail.com"];
    }
    match /orders/{id} { allow read, write: if shop(); }
    match /depts/{id}  { allow read, write: if shop(); }
  }
}
